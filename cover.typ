#set page(
  paper: "a4",
  margin: (top: 2cm, left: 3cm, right: 2cm, bottom: 2cm),
  numbering: none,
)

#align(center)[
  #set text(font: "Varela Round", size: 16pt)
  // Tác giả
]

#v(2fr)

#align(center)[
  #box(inset: 15pt, radius: 10pt)[
    #set text(font: "Corinthia", size: 45pt, fill: red.darken(30%))
    Lý thuyết #h(0.3em)-#h(0.3em)  Bài tập
  ]
]

#v(-7em)

#align(center)[
  #set text(font: "Varela Round", size: 90pt, weight: "medium")
  TOÁN
  #box(inset: 15pt, fill: red.darken(30%), radius: 15pt)[
    #set text(fill: white)
    8
  ]
]

#v(2fr)

#align(center)[
  #circle(inset: -35pt, stroke: 10pt + red.darken(30%), fill: white)[
    #circle(inset: -10pt, stroke: 5pt + red)[
      #image("imgs/cover-chan-dung-thales.svg", height: 8cm)
    ]
  ]
]

#v(2fr)

#align(center)[
  #set text(font: "Varela Round", size: 16pt)
  Năm học 2026 - 2027
]
